# =============================================================================
# ClaimBlitz Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# -- General --
ENVIRONMENT=development
DEBUG=true

# -- LLM Provider (Groq — free, fast, OpenAI-compatible) --
# Get your free API key at: https://console.groq.com
# Pick a chat model your Groq account has access to (list at /openai/v1/models).
OPENAI_API_KEY=gsk_your_groq_api_key_here
OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# -- LLM Settings --
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
USE_OLLAMA_ONLY=false

# -- MongoDB --
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=claimblitz

# -- Pinecone Vector Memory (optional for dev) --
# For local dev without Pinecone, agents use in-memory keyword matching.
# For production semantic recall:
PINECONE_USE_LOCAL=false
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=claimblitz-memory

# -- Embeddings --
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# -- Redis (optional for dev — falls back to in-memory) --
REDIS_URL=redis://localhost:6379/0

# -- RabbitMQ (optional — only needed for Celery workers) --
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# -- Security (optional for dev — bypassed in development mode) --
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
RATE_LIMIT_PER_MINUTE=60

# -- Observability (optional) --
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# -- Vision OCR (for scanned / image-only PDFs with no text layer) --
# Text-layer PDFs skip this entirely (fast, offline). Scanned PDFs are
# rendered to images and transcribed by Google Gemini's vision model.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cap pages sent to Gemini per scanned document (keeps live runs fast).
VISION_OCR_MAX_PAGES=6
